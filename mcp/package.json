  "homepage": "https://github.com/thathman/chowdeck-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/thathman/chowdeck-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/thathman/chowdeck-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
