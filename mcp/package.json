{
  "name": "@thathman/chowdeck-mcp",
  "version": "0.5.1",
  "description": "Unofficial Model Context Protocol (MCP) server for Chowdeck (Nigeria) — discover vendors, build carts, place and track orders from an AI agent. Not affiliated with Chowdeck.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chowdeck-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node -e \"try{require('fs').chmodSync('dist/index.js',0o755)}catch{}\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepack": "cp ../README.md ../LICENSE .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chowdeck",
    "food-delivery",
    "nigeria",
    "claude",
    "ai-agent"
  ],
  "author": "Hendrix Nwaokolo (@thathman) <hello@airixmedia.com>",
  "license": "MIT",
  "homepage": "https://github.com/thathman/chowdeck-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/thathman/chowdeck-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/thathman/chowdeck-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
